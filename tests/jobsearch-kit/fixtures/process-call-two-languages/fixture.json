  ],
  "judge": {
    "files": ["{{date}}_Nordwind_Pay_*/*_summary.md", "{{date}}_Nordwind_Pay_*/*_side_talk.md", "{{date}}_Nordwind_Pay_*/*_transcript.md", "_Companies/Nordwind_Pay/*.md"],
